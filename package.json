{
  "name": "apartalo-core",
  "version": "1.0.0",
  "description": "Plataforma multi-tenant para comercio por WhatsApp",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --testPathPattern=tests/ --forceExit",
    "test:unit": "jest --testPathPattern=tests/unit/ --forceExit",
    "test:e2e": "jest --testPathPattern=tests/e2e/ --forceExit --runInBand",
    "test:watch": "jest --testPathPattern=tests/ --watch",
    "test:coverage": "jest --testPathPattern=tests/ --coverage --forceExit"
  },
  "keywords": [
    "whatsapp",
    "ecommerce",
    "multi-tenant",
    "live-commerce",
    "bot"
  ],
  "author": "Keyla Cusi - RosalCafe",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "googleapis": "^118.0.0",
    "socket.io": "^4.7.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "clearMocks": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
